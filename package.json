{
  "name": "akitchen-kho-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Hệ thống Quản lý Kho Vận, Vật tư, Cận date & Báo cáo Suất ăn A.Kitchen chạy trên Cloudflare Pages + Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "tailwindcss -i ./src/css/style.css -o ./public/assets/app.css --minify",
    "dev:css": "tailwindcss -i ./src/css/style.css -o ./public/assets/app.css --watch",
    "db:init": "wrangler d1 execute akitchen_kho_db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute akitchen_kho_db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute akitchen_kho_db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute akitchen_kho_db --remote --file=./seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/estedad": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/forms": "^0.5.11",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
